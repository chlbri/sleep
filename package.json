{
  "name": "@bemedev/sleep",
  "version": "0.2.2",
  "description": "The Ultimate package to sleep 🛌 😪 like a baby 👩🏾‍🍼",
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "module": "lib/index.js",
  "type": "module",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/repro-ts-full"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sleep",
    "wait",
    "promise",
    "callback",
    "async",
    "asynchronous"
  ],
  "scripts": {
    "ci": "pnpm config:off && pnpm run lint && pnpm run build && pnpm run test",
    "ci:admin": "pnpm run upgrade && pnpm run ci",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "rollup": "rollup -c",
    "prepare": "husky install",
    "build": "rm -rf lib && pnpm run rollup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "remove": "rm -rf lib node_modules pnpm-lock.yaml",
    "clean": "pnpm run remove && pnpm run config",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "eslint": "eslint \"{src/**/*,App}.{ts,tsx}\"",
    "lint": "pnpm run prettier && pnpm run eslint --fix",
    "lint-watch": "onchange --await-write-finish 5500 \"**/*\" -- pnpm run lint",
    "postpublish": "git fetch & git pull",
    "prepublishOnly": "pnpm run build && pnpm run lint",
    "upgrade": "pnpm up --latest && pnpm add -D @vitest/coverage-v8@3.2.4 vitest@3.2.4"
  },
  "devDependencies": {
    "@bemedev/build-tests": "^0.1.2",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/rollup-config": "^0.2.2",
    "@bemedev/sequence": "^0.0.1",
    "@bemedev/vitest-alias": "^0.0.3",
    "@bemedev/vitest-exclude": "^0.1.1",
    "@bemedev/vitest-extended": "^1.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.3",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "rollup": "^4.59.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
