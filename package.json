{
  "name": "@bemedev/sleep",
  "author": "chlbri <bri_lvi@icloud.com>",
  "version": "0.2.1",
  "description": "The Ultimate package to sleep 🛌 😪 like a baby 👩🏾‍🍼",
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "module": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/sleep.git"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "sleep",
    "wait",
    "promise",
    "callback",
    "async",
    "asynchronous"
  ],
  "scripts": {
    "config": "pnpm install",
    "rollup": "rollup -c",
    "prepare": "husky install",
    "build": "rm -rf lib && pnpm run rollup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "remove": "rm -rf lib node_modules pnpm-lock.yaml",
    "clean": "pnpm run remove && pnpm run config",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "eslint": "eslint \"{src/**/*,App}.{ts,tsx}\"",
    "lint": "pnpm run prettier && pnpm run eslint --fix",
    "lint-watch": "onchange --await-write-finish 5500 \"**/*\" -- pnpm run lint",
    "postpublish": "git fetch & git pull",
    "prepublishOnly": "pnpm run build && pnpm run lint",
    "upgrade": "pnpm up --latest && pnpm add -D @vitest/coverage-v8@3.2.4 vitest@3.2.4"
  },
  "devDependencies": {
    "@bemedev/rollup-config": "^0.2.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
